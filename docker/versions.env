# Versões validadas para o Dockerfile da esteira
# Atualizado em: 2026-07-22

# Imagem base
# Digest fixado do manifesto amd64 (docker pull python:3.12-slim em 2026-07-22)
BASE_IMAGE=python:3.12-slim
BASE_IMAGE_DIGEST=sha256:57cd7c3a7a273101a6485ba99423ee568157882804b1124b4dd04266317710de

# GitHub CLI — versão do pacote (.deb), sem 'v'
# Instalado via .deb arquivado em github.com/cli/cli/releases (NAO pelo repo APT
# https://cli.github.com/packages, que serve apenas a última e quebra pins antigos).
# 2.97.0 saiu de circulação no repo APT → migrado para .deb arquivado + bump 2.101.0 (2026-09-15)
GH_VERSION=2.101.0

# PyYAML — versão pip
# Fonte: pip3 index versions pyyaml → versão estável mais recente
PYYAML_VERSION=6.0.2

# kiro-cli
# Fonte: BUILD-INFO extraído de kirocli-x86_64-linux.zip (build 2026-08-11)
# URL /latest/ serve sempre o mais recente → SHA repinado em 2026-08-14
# Binário glibc (x86_64-unknown-linux-gnu) — validado em python:3.12-slim ✓
KIRO_CLI_VERSION=2.18.0
KIRO_CLI_SHA256=05c880af3ce6b7c78e1eb23f7a90b4e29536e91989a92e2c7e960a74b80fe63d
KIRO_CLI_URL=https://desktop-release.q.us-east-1.amazonaws.com/latest/kirocli-x86_64-linux.zip

# Pacotes APT (dentro de python:3.12-slim / Debian 13)
# Fonte: apt-cache show <pkg> executado dentro do container python:3.12-slim em 2026-07-22
GIT_APT_VERSION=1:2.47.3-0+deb13u1
OPENSSH_CLIENT_APT_VERSION=1:10.0p1-7+deb13u4

# ─── Toolchain de dev/test para agentes (Opção B: Docker-in-Docker) ──────────
# O container do agente precisa subir as stacks dev/qa do produto (docker compose)
# e rodar ITs Testcontainers. O daemon vive num sidecar isolado (docker:dind), e
# o cliente docker + plugins + jq + JDK/Maven são embutidos na imagem do agente.
# Homologação NÃO é coberta aqui (roda fora de containers, no host).

# docker:dind — daemon Docker isolado (sidecar privileged no docker-compose.yml).
# O agente fala com ele via DOCKER_HOST=tcp://127.0.0.1:2375 (netns compartilhado).
DIND_IMAGE=docker:27.3.1-dind

# Cliente docker (binário estático oficial; extraímos só o client 'docker').
DOCKER_CLI_VERSION=27.3.1
DOCKER_CLI_URL=https://download.docker.com/linux/static/stable/x86_64/docker-27.3.1.tgz

# Plugin docker compose v2 (instalado em /usr/local/lib/docker/cli-plugins).
DOCKER_COMPOSE_VERSION=2.29.7
DOCKER_COMPOSE_URL=https://github.com/docker/compose/releases/download/v2.29.7/docker-compose-linux-x86_64

# Plugin docker buildx (necessário para 'docker compose build' via BuildKit).
DOCKER_BUILDX_VERSION=0.17.1
DOCKER_BUILDX_URL=https://github.com/docker/buildx/releases/download/v0.17.1/buildx-v0.17.1.linux-amd64

# jq — usado pelos orquestradores dev.sh / run.sh do produto (status.json etc.).
JQ_VERSION=1.7.1
JQ_URL=https://github.com/jqlang/jq/releases/download/jq-1.7.1/jq-linux-amd64

# JDK Temurin 21 — build/testes do backend Spring Boot (mvn). Versão alinhada ao
# que o produto já usava ad-hoc; agora embutida e reproduzível.
TEMURIN_JDK_VERSION=21.0.5+11
TEMURIN_JDK_URL=https://github.com/adoptium/temurin21-binaries/releases/download/jdk-21.0.5%2B11/OpenJDK21U-jdk_x64_linux_hotspot_21.0.5_11.tar.gz

# Apache Maven — arquivado permanentemente em archive.apache.org (pin estável).
MAVEN_VERSION=3.9.9
MAVEN_URL=https://archive.apache.org/dist/maven/maven-3/3.9.9/binaries/apache-maven-3.9.9-bin.tar.gz
