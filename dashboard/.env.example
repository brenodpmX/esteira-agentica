# ─── Dashboard de telemetria das esteiras ────────────────────────────────────
# cp .env.example .env  e preencha as senhas antes do primeiro `docker compose up -d`.

# Login do Grafana (obrigatório, sem default)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# Porta do Grafana no host (publicada só em 127.0.0.1)
DASHBOARD_PORT=3000

# Usuário do ClickHouse (não exposto no host)
CLICKHOUSE_USER=esteira
CLICKHOUSE_PASSWORD=

# Retenção de eventos, métricas e traces em horas (720 = 30 dias).
# Vale na criação das tabelas; para mudar depois, ver README (Retenção).
RETENCAO_HORAS=720

# Intervalo (s) com que o config-sync relê o dashboard.yml
CONFIG_SYNC_INTERVALO=30
