# ─────────────────────────────────────────────────────────────────────────────
# .dockerignore — reduz o contexto de build enviado ao daemon
#
# O contexto já carrega ~775 MB de binários do kiro-cli (kiro-cli +
# kiro-cli-chat). Sem este arquivo, somaria também clones de repositórios,
# logs e estado interno — nenhum deles usado pelo Dockerfile (montados como
# volumes em runtime).
# ─────────────────────────────────────────────────────────────────────────────

# Estado e artefatos de runtime (montados via volumes)
.pipe/
logs/
repo/
contexts/
pipe.yml

# Git
.git/
.gitignore

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# Segredos e config local
.env

# Código de referência (versão antiga)
oldversion/

# Artefatos Docker (não precisam entrar na imagem)
docker-compose.yml
.dockerignore
